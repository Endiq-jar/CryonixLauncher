<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Holding most of the dynamic content. Account switching now lives inside
         the fragment itself (bottom-left), and every top-bar action now lives in
         the right side bar below, so no top bar/account bar is needed here anymore. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_side_bar" />

    <!-- Right side bar: holds the settings/home toggle (previously the only
         top-bar action) plus quick access to custom controls, jar execution,
         log sharing and the game directory (previously buttons in the main list). -->
    <ScrollView
        android:id="@+id/right_side_bar"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="0dp"
        android:background="@color/background_status_bar"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal">

            <ImageButton
                android:id="@+id/setting_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_px_sliders"
                android:scaleType="fitCenter"
                android:padding="@dimen/_8sdp" />

            <View
                style="@style/LauncherFragment_Divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/padding_tiny"
                android:layout_marginHorizontal="@dimen/padding_large" />

            <ImageButton
                android:id="@+id/sidebar_custom_control_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_px_gamepad"
                android:scaleType="fitCenter"
                android:padding="@dimen/_8sdp"
                android:contentDescription="@string/mcl_option_customcontrol" />

            <ImageButton
                android:id="@+id/sidebar_install_jar_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_px_java_run"
                android:scaleType="fitCenter"
                android:padding="@dimen/_8sdp"
                android:contentDescription="@string/main_install_jar_file" />

            <ImageButton
                android:id="@+id/sidebar_share_logs_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_px_sharelog"
                android:scaleType="fitCenter"
                android:padding="@dimen/_8sdp"
                android:contentDescription="@string/main_share_logs" />

            <ImageButton
                android:id="@+id/sidebar_open_directory_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_px_folder"
                android:scaleType="fitCenter"
                android:padding="@dimen/_8sdp"
                android:contentDescription="@string/mcl_button_open_directory" />

        </LinearLayout>
    </ScrollView>

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_side_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
